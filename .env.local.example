# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where OAuth redirects back to. Change to your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- not needed until later slices ---
# Server-only. Used by the daily check job to bypass RLS. Never expose to the client.
# SUPABASE_SERVICE_ROLE_KEY=
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
