# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where OAuth redirects back to. Change to your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. From Supabase → Settings → API → Secret keys (service_role).
# Used by the check engine to write snapshots/changes, bypassing RLS. Never
# expose to the client — only read inside "use server" files.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Generates the plain-English change summaries. Set ONE of these:
#   GROQ_API_KEY      — from console.groq.com (free tier, GPT-OSS-20B). Preferred.
#   ANTHROPIC_API_KEY — from console.anthropic.com (Haiku 4.5). Fallback.
# If neither is set, changes are still recorded (summary stays null) — the app
# degrades gracefully.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Live web grounding for the homepage competitor finder — the thing
# that makes it find RECENT / niche competitors, not just famous ones. From
# exa.ai (free tier, monthly credits, NO card, so no overage/bill is possible).
# When set, the finder searches Exa for current competitors and the Groq model
# reads those live results. Unset = finder uses the offline model's knowledge only.
EXA_API_KEY=

# Server-only. Sends the weekly digest email. From console.resend.com.
# Without it, the digest job still runs and reports each send as skipped
# (graceful degradation) — nothing is emailed.
RESEND_API_KEY=
# Verified sender. Defaults to Resend's onboarding@resend.dev (test only —
# delivers to your own account email). Set a verified-domain address for prod.
# EMAIL_FROM=Trailwatch <digest@trailwatch.houseofruga.com>

# Protects the cron endpoints. Vercel Cron sends this as a Bearer token; set the
# same value here and in Vercel. If unset, the endpoint is unauthenticated.
CRON_SECRET=

# Comma-separated emails that always get Pro without paying (founder/team comp
# accounts), independent of Paddle. e.g. COMP_EMAILS=you@example.com,teammate@example.com
COMP_EMAILS=

# Billing via Paddle (Billing product, not Classic).
# Client-side (safe to expose): from Paddle → Developer Tools → Authentication.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# "sandbox" while testing, "production" when live.
NEXT_PUBLIC_PADDLE_ENV=sandbox
# The two Pro prices (monthly $19, annual $190): Paddle → Catalog → Products →
# your Pro product → each price's id (pri_...). Both live on the same Pro
# product — Paddle Billing supports multiple prices per product for this.
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_PRO_ANNUAL=
# Server-only. API key from Paddle → Developer Tools → Authentication (used to
# cancel subscriptions).
PADDLE_API_KEY=
# Server-only. Signing secret for the webhook: Paddle → Developer Tools →
# Notifications → your destination. Used to verify incoming webhooks.
PADDLE_WEBHOOK_SECRET=
